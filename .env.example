# Copiaza acest fisier in `.env` si completeaza cu valori reale:
#   cp .env.example .env
#
# Genereaza valori random:
#   printf "POSTGRES_PASSWORD=%s\nN8N_ENCRYPTION_KEY=%s\n" \
#     "$(openssl rand -hex 16)" "$(openssl rand -hex 32)" > .env

POSTGRES_PASSWORD=inlocuieste_cu_parola_random
N8N_ENCRYPTION_KEY=inlocuieste_cu_cheie_random
